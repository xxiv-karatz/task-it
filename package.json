{
  "name": "task-it",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "web/backend",
    "web/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix web/backend run dev\" \"npm --prefix web/frontend run dev\"",
    "build": "npm --prefix web/frontend run build",
    "start": "npm --prefix web/backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
